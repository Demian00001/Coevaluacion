<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coevaluacion</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Coevaluacion.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        
        <!-- Sidebar -->
        <div id="sidebar-wrapper" class="shadow">
            <div class="sidebar-heading text-center">
                <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Coevaluación
            </div>
            
            <div class="list-group list-group-flush mt-3">
                <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>

                <div class="sidebar-divider">Administración</div>
                
                <a asp-controller="Equipos" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipos" ? "active" : "")">
                    <i class="bi bi-diagram-3 me-2"></i>Equipos
                </a>
                <a asp-controller="Integrantes" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Integrantes" ? "active" : "")">
                    <i class="bi bi-people me-2"></i>Integrantes
                </a>
                <a asp-controller="Criterios" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Criterios" ? "active" : "")">
                    <i class="bi bi-card-checklist me-2"></i>Criterios
                </a>
                <a asp-controller="Periodos" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Periodos" ? "active" : "")">
                    <i class="bi bi-calendar-event me-2"></i>Periodos
                </a>

                <div class="sidebar-divider">Operación</div>
                
                <a asp-controller="Evaluaciones" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluaciones" ? "active" : "")">
                    <i class="bi bi-pencil-square me-2"></i>Evaluaciones
                </a>

                <div class="sidebar-divider">Análisis</div>
                
                <a asp-controller="Reportes" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")">
                    <i class="bi bi-bar-chart-line me-2"></i>Reportes
                </a>
            </div>
        </div>
        <!-- /#sidebar-wrapper -->

        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100 bg-light">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-3 py-2 mb-4">
                <div class="container-fluid">
                    <button class="btn btn-outline-secondary" id="menu-toggle">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="ms-auto d-flex align-items-center">
                        <i class="bi bi-person-circle fs-4 text-secondary me-2"></i>
                        <span class="text-muted fw-bold">Administrador</span>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4 pb-5">
                <main role="main">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
        <!-- /#page-content-wrapper -->

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById("menu-toggle").addEventListener("click", function(e) {
            e.preventDefault();
            document.getElementById("wrapper").classList.toggle("toggled");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
