@model Coevaluacion.ViewModels.ReporteEquipoViewModel

@{
    ViewData["Title"] = "Resultado del Equipo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Resultados del Equipo</h1>
    <div>
        <a asp-action="DescargarEquipoPdf" asp-route-periodoId="@ViewBag.PeriodoId" asp-route-equipoId="@ViewBag.EquipoId" class="btn btn-danger me-2"><i class="bi bi-file-pdf"></i> Descargar PDF</a>
        <a asp-action="Equipo" class="btn btn-secondary">← Nuevo Reporte</a>
    </div>
</div>

<div class="card shadow-sm mb-4 border-primary">
    <div class="card-body bg-light">
        <div class="row text-center text-md-start">
            <div class="col-md-4 border-end">
                <h4 class="mb-1 text-primary">@Model.EquipoNombre</h4>
                <p class="mb-0 text-muted"><strong>Periodo:</strong> @Model.PeriodoNombre</p>
            </div>
            <div class="col-md-4 border-end">
                <h5 class="mb-1">Promedio General</h5>
                <h3 class="text-success">@Html.DisplayFor(m => m.PromedioGeneralEquipo)</h3>
            </div>
            <div class="col-md-4">
                <h5 class="mb-1">Mejor Desempeño</h5>
                <h5 class="text-primary mt-2">
                    <i class="bi bi-star-fill text-warning"></i> @Model.MejorIntegranteNombre
                </h5>
                <p class="small text-muted mb-0">(@Model.CantidadIntegrantes Integrantes Totales)</p>
            </div>
        </div>
    </div>
</div>

<h4>Desempeño por Integrante</h4>
<table class="table table-striped table-hover mt-3 shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Posición</th>
            <th>Nombre Completo</th>
            <th class="text-center">Promedio Recibido</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rank = 1;
        }
        @foreach (var integrante in Model.Integrantes)
        {
            <tr>
                <td class="fw-bold">#@rank</td>
                <td>@integrante.NombreCompleto</td>
                <td class="text-center">
                    <span class="badge @(integrante.PromedioGeneral >= 8 ? "bg-success" : (integrante.PromedioGeneral >= 6 ? "bg-warning" : "bg-danger")) fs-6 px-3">
                        @Html.DisplayFor(m => integrante.PromedioGeneral)
                    </span>
                </td>
            </tr>
            rank++;
        }
    </tbody>
</table>
