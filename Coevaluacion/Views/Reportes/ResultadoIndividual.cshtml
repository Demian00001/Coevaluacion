@model Coevaluacion.ViewModels.ReporteIndividualViewModel

@{
    ViewData["Title"] = "Resultado del Reporte";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Resultados de Coevaluación</h1>
    <a asp-action="Individual" class="btn btn-secondary">← Nuevo Reporte</a>
</div>

<div class="card shadow-sm mb-4 border-info">
    <div class="card-body bg-light">
        <div class="row">
            <div class="col-md-6">
                <h4 class="mb-1 text-primary">@Model.NombreEstudiante</h4>
                <p class="mb-0 text-muted"><strong>Equipo:</strong> @Model.EquipoNombre</p>
            </div>
            <div class="col-md-6 text-md-end">
                <h5 class="mb-1"><strong>Periodo:</strong> @Model.PeriodoNombre</h5>
                <h3 class="mt-2 text-success">
                    Promedio General: <strong>@Html.DisplayFor(m => m.PromedioGeneral)</strong>
                </h3>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Promedios por Criterio -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Promedio por Criterio</h5>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.PromediosPorCriterio)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fs-5">@item.CriterioNombre</span>
                        <span class="badge bg-primary rounded-pill fs-6 px-3">
                            @Html.DisplayFor(modelItem => item.Promedio)
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Comentarios -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Comentarios Recibidos</h5>
            </div>
            <div class="card-body">
                @if (Model.Comentarios.Any())
                {
                    <ul class="list-unstyled">
                        @foreach (var comentario in Model.Comentarios)
                        {
                            <li class="mb-3 pb-3 border-bottom">
                                <i class="text-muted">"@comentario"</i>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted fst-italic">No se recibieron comentarios en este período.</p>
                }
            </div>
        </div>
    </div>
</div>
