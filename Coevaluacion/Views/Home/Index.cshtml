@model Coevaluacion.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Principal";
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">Sistema de Coevaluación de Equipos</h1>
        <p class="text-muted mb-0">Bienvenido al centro de operaciones. Aquí puedes administrar y monitorear el desempeño global.</p>
    </div>
</div>

<!-- Acciones Rápidas -->
<div class="mb-5">
    <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Acciones Rápidas</h5>
    <div class="row g-3">
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Equipos" asp-action="Create" class="btn btn-outline-primary w-100 btn-action h-100 text-decoration-none bg-white">
                <i class="bi bi-diagram-3"></i>
                <span>Nuevo Equipo</span>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Integrantes" asp-action="Create" class="btn btn-outline-success w-100 btn-action h-100 text-decoration-none bg-white">
                <i class="bi bi-person-plus"></i>
                <span>Nuevo Integrante</span>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Periodos" asp-action="Create" class="btn btn-outline-info w-100 btn-action h-100 text-decoration-none bg-white">
                <i class="bi bi-calendar-plus"></i>
                <span>Nuevo Periodo</span>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Evaluaciones" asp-action="Index" class="btn btn-outline-warning w-100 btn-action h-100 text-decoration-none bg-white">
                <i class="bi bi-pencil-square"></i>
                <span>Evaluar</span>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-secondary w-100 btn-action h-100 text-decoration-none bg-white">
                <i class="bi bi-bar-chart-line"></i>
                <span>Ver Reportes</span>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Reportes" asp-action="RankingGeneral" class="btn btn-outline-danger w-100 btn-action h-100 text-decoration-none bg-white">
                <i class="bi bi-file-pdf"></i>
                <span>Exportar PDF</span>
            </a>
        </div>
    </div>
</div>

<!-- Tarjetas de Resumen -->
<div class="row mb-4 g-4">
    <div class="col-md-3">
        <div class="card card-hover border-0 shadow-sm text-center h-100 rounded-3">
            <div class="card-body py-4">
                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-3 mb-3">
                    <i class="bi bi-diagram-3-fill fs-2 text-primary"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalEquipos</h2>
                <p class="text-muted mb-0 fw-semibold text-uppercase" style="font-size: 0.8rem;">Total Equipos</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-hover border-0 shadow-sm text-center h-100 rounded-3">
            <div class="card-body py-4">
                <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex p-3 mb-3">
                    <i class="bi bi-people-fill fs-2 text-success"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalIntegrantes</h2>
                <p class="text-muted mb-0 fw-semibold text-uppercase" style="font-size: 0.8rem;">Total Integrantes</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-hover border-0 shadow-sm text-center h-100 rounded-3">
            <div class="card-body py-4">
                <div class="rounded-circle bg-info bg-opacity-10 d-inline-flex p-3 mb-3">
                    <i class="bi bi-ui-checks fs-2 text-info"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalEvaluaciones</h2>
                <p class="text-muted mb-0 fw-semibold text-uppercase" style="font-size: 0.8rem;">Total Evaluaciones</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-hover border-0 shadow-sm text-center h-100 rounded-3">
            <div class="card-body py-4">
                <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex p-3 mb-3">
                    <i class="bi bi-calendar-check-fill fs-2 text-warning"></i>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalPeriodosActivos</h2>
                <p class="text-muted mb-0 fw-semibold text-uppercase" style="font-size: 0.8rem;">Periodos Activos</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top 5 Estudiantes -->
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-trophy-fill text-warning me-2"></i>Top 5 Estudiantes</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="text-muted" style="font-size: 0.85rem;">
                            <tr>
                                <th class="text-center" style="width: 60px;">Pos</th>
                                <th>Nombre Completo</th>
                                <th class="text-center">Promedio</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @if (Model.TopEstudiantes.Any())
                            {
                                @foreach (var est in Model.TopEstudiantes)
                                {
                                    <tr>
                                        <td class="text-center fw-bold text-muted">#@est.Posicion</td>
                                        <td class="fw-semibold">
                                            @if (est.Posicion == 1) { <i class="bi bi-star-fill text-warning me-1"></i> }
                                            @est.NombreCompleto
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                @Html.DisplayFor(m => est.PromedioGeneral)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">No hay estudiantes evaluados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimas Evaluaciones -->
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-clock-history text-secondary me-2"></i>Últimas Evaluaciones</h5>
            </div>
            <div class="card-body p-0 mt-2">
                <ul class="list-group list-group-flush">
                    @if (Model.UltimasEvaluaciones.Any())
                    {
                        @foreach (var ev in Model.UltimasEvaluaciones)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-arrow-left-right text-muted"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-dark" style="font-size: 0.95rem;">@ev.EvaluadorNombre</span>
                                        <span class="text-muted d-block" style="font-size: 0.85rem;">evaluó a @ev.EvaluadoNombre</span>
                                    </div>
                                </div>
                                <small class="text-muted" style="font-size: 0.8rem;">
                                    @ev.Fecha.ToString("dd MMM HH:mm")
                                </small>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-4 border-0">No se han registrado evaluaciones.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Gráfica Promedio por Equipo -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm mb-4 rounded-3">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Promedio General por Equipo</h5>
            </div>
            <div class="card-body">
                <div style="height: 350px;">
                    <canvas id="equiposChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('equiposChart').getContext('2d');
            
            var labels = @Html.Raw(Json.Serialize(Model.EquiposLabels));
            var data = @Html.Raw(Json.Serialize(Model.EquiposPromedios));

            var chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Promedio General',
                        data: data,
                        backgroundColor: 'rgba(13, 110, 253, 0.8)',
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 0,
                        borderRadius: 6,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 10,
                            grid: {
                                borderDash: [2, 4],
                                color: 'rgba(0,0,0,0.05)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        });
    </script>
}
