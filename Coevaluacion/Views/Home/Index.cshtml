@model Coevaluacion.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Principal";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">Dashboard Principal</h1>
</div>

<!-- Tarjetas de Resumen -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-primary text-center h-100">
            <div class="card-body">
                <i class="bi bi-diagram-3 fs-1 text-primary"></i>
                <h2 class="mt-2">@Model.TotalEquipos</h2>
                <p class="text-muted mb-0">Total Equipos</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-success text-center h-100">
            <div class="card-body">
                <i class="bi bi-people fs-1 text-success"></i>
                <h2 class="mt-2">@Model.TotalIntegrantes</h2>
                <p class="text-muted mb-0">Total Integrantes</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-info text-center h-100">
            <div class="card-body">
                <i class="bi bi-ui-checks fs-1 text-info"></i>
                <h2 class="mt-2">@Model.TotalEvaluaciones</h2>
                <p class="text-muted mb-0">Total Evaluaciones</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-warning text-center h-100">
            <div class="card-body">
                <i class="bi bi-calendar-event fs-1 text-warning"></i>
                <h2 class="mt-2">@Model.TotalPeriodosActivos</h2>
                <p class="text-muted mb-0">Periodos Activos</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Top 5 Estudiantes -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Top 5 Estudiantes</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 80px;">Posición</th>
                            <th>Nombre Completo</th>
                            <th class="text-center">Promedio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopEstudiantes.Any())
                        {
                            @foreach (var est in Model.TopEstudiantes)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-muted">#@est.Posicion</td>
                                    <td>
                                        @if (est.Posicion == 1) { <i class="bi bi-star-fill text-warning me-1"></i> }
                                        @est.NombreCompleto
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success fs-6">
                                            @Html.DisplayFor(m => est.PromedioGeneral)
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">No hay estudiantes evaluados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Últimas Evaluaciones -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Últimas Evaluaciones</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.UltimasEvaluaciones.Any())
                    {
                        @foreach (var ev in Model.UltimasEvaluaciones)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <span class="fw-bold">@ev.EvaluadorNombre</span>
                                    <i class="bi bi-arrow-right mx-2 text-muted"></i>
                                    <span>@ev.EvaluadoNombre</span>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i> @ev.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-3">No se han registrado evaluaciones.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Gráfica Promedio por Equipo -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Promedio General por Equipo</h5>
            </div>
            <div class="card-body">
                <canvas id="equiposChart" style="max-height: 400px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Cargar Chart.js mediante CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('equiposChart').getContext('2d');
            
            // Datos obtenidos desde el ViewModel mediante Razor
            var labels = @Html.Raw(Json.Serialize(Model.EquiposLabels));
            var data = @Html.Raw(Json.Serialize(Model.EquiposPromedios));

            var chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Promedio General',
                        data: data,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 10,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        });
    </script>
}
