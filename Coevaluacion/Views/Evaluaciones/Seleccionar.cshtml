@model Coevaluacion.ViewModels.SeleccionEvaluadorViewModel

@{
    ViewData["Title"] = "Paso 1: Seleccionar Evaluador";
}

<h1>Coevaluación</h1>
<h4 class="text-muted">Paso 1: Seleccionar Evaluador y Periodo</h4>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Seleccionar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="EvaluadorId" class="control-label fw-bold"></label>
                <select asp-for="EvaluadorId" class="form-select" asp-items="ViewBag.EvaluadorId">
                    <option value="">-- Seleccione el Evaluador --</option>
                </select>
                <span asp-validation-for="EvaluadorId" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="PeriodoId" class="control-label fw-bold"></label>
                <select asp-for="PeriodoId" class="form-select" asp-items="ViewBag.PeriodoId">
                    <option value="">-- Seleccione el Periodo --</option>
                </select>
                <span asp-validation-for="PeriodoId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Continuar" class="btn btn-primary btn-lg" />
                <a asp-action="Index" class="btn btn-secondary btn-lg ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
